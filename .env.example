# Application: Supabase transaction pooler.
# URL-encode special characters in the database password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true"

# Prisma CLI: Supabase session pooler (IPv4 compatible).
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# For full certificate and hostname verification, replace the query parameters
# in BOTH URLs with: sslmode=verify-full&sslrootcert=./certs/supabase-ca.crt
# Download that certificate from Supabase Dashboard > Database Settings.

PORT=3000
